    "deploy:production": "netlify deploy --prod"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.0",
    "nodemailer": "^6.9.15",
    "serverless-http": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
