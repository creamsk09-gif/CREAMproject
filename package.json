{
  "name": "stock-logistics-sisaket",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital stock logistics prototype based on the Sisaket stock workbook and project pitch",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
